# CortexHeal Environment Configuration Example
# Copy this to .env for local development

# -------------------------
# Database Configuration
# -------------------------
# Local development on Windows host connecting to Docker uses port 5433
DATABASE_URL=postgresql://cortexheal:cortexpassword@localhost:5433/cortexheal_db
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_TIMEOUT=30

# -------------------------
# API / Control Plane Configuration
# -------------------------
CORTEXHEAL_HOST=0.0.0.0
CORTEXHEAL_PORT=8000
CORTEXHEAL_WORKERS=4
ENVIRONMENT=development

# -------------------------
# Authentication & Authorization
# -------------------------
# Use comma-separated values for multiple tokens
# DO NOT use these defaults in production
ADMIN_TOKENS=dev-admin-key
OPERATOR_TOKENS=dev-operator-key
VIEWER_TOKENS=dev-viewer-key

# -------------------------
# Telemetry & Performance
# -------------------------
ENABLE_TELEMETRY=True
MAX_QUEUE_SIZE=10000
BATCH_SIZE=100
FLUSH_INTERVAL_MS=500

# -------------------------
# Detection
# -------------------------
DETECTOR_VERSION=1.0
POLICY_VERSION=1.0

# -------------------------
# Rate Limiting
# -------------------------
API_RATE_LIMIT_PER_MIN=60

# -------------------------
# AI / Learning Configuration
# -------------------------
# Only required if AI Provider is set to real instead of mock
# CORTEXHEAL_AI_API_KEY=your_api_key_here

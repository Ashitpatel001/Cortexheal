# ═══════════════════════════════════════════════════════════
# CortexHeal — PRODUCTION Environment Configuration
# ═══════════════════════════════════════════════════════════
# Copy this file to .env.production on the server.
# NEVER commit .env.production to version control.
# Every value below is a deliberately wrong placeholder.
# Replace ALL of them with real values before starting.
# ═══════════════════════════════════════════════════════════

# ── Database ──────────────────────────────────────────────
# Points at the Postgres container on the Docker network.
# The password here MUST match POSTGRES_PASSWORD below.
DATABASE_URL=postgresql://cortexheal:CHANGE_ME_REAL_PASSWORD@postgres:5432/cortexheal_db

# The password used by the Postgres container itself.
# docker-compose.prod.yml injects this into both the postgres and api services.
POSTGRES_PASSWORD=CHANGE_ME_REAL_PASSWORD
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_TIMEOUT=30

# ── Runtime ───────────────────────────────────────────────
ENVIRONMENT=production
CORTEXHEAL_HOST=0.0.0.0
CORTEXHEAL_PORT=8000
CORTEXHEAL_WORKERS=4

# ── Authentication ────────────────────────────────────────
# ALLOW_DEV_TOKENS must be False in production — this is
# enforced by code (config.py rejects default tokens when
# ENVIRONMENT=production). Do NOT set it to True.
ALLOW_DEV_TOKENS=False

# These static token lists are ONLY used when ALLOW_DEV_TOKENS=True.
# In production, all auth goes through the database API-key system.
# Leave these as dummy values — they will never be checked.
ADMIN_TOKENS=UNUSED_IN_PRODUCTION
OPERATOR_TOKENS=UNUSED_IN_PRODUCTION
VIEWER_TOKENS=UNUSED_IN_PRODUCTION

# ── CORS ──────────────────────────────────────────────────
# Comma-separated list of allowed origins.
# Must match your actual subdomain(s) exactly.
CORTEXHEAL_CORS_ORIGINS=https://app.YOURDOMAIN.com,https://YOURDOMAIN.com

# ── Demo Runner ───────────────────────────────────────────
# The org_id that cron_demo_runner.py writes all demo data into.
# Must match the org_id of the VIEWER-only demo API key.
DEMO_ORG_ID=demo_public

# ── Telemetry ─────────────────────────────────────────────
ENABLE_TELEMETRY=True
MAX_QUEUE_SIZE=10000
BATCH_SIZE=100
FLUSH_INTERVAL_MS=500

# ── Detection ─────────────────────────────────────────────
DETECTOR_VERSION=1.0
POLICY_VERSION=1.0

# ── Rate Limiting ─────────────────────────────────────────
API_RATE_LIMIT_PER_MIN=120

# ── AI / Learning (optional) ─────────────────────────────
# Only required if AI Provider is set to real instead of mock.
# CORTEXHEAL_AI_API_KEY=your_real_api_key_here
